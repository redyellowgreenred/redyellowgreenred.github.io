---
import Layout from '../components/AcademicLayout.astro';
import KnowledgeItem from '../components/KnowledgeItem.astro';
import {entries,stats} from '../lib/data.js';
import {period} from '../lib/entry.js';
import {areaColors} from '../lib/areas.js';
---
<Layout title="Knowledge" active="knowledge" board><div class="page-title"><h2>Knowledge <span>学过什么</span></h2><label class="search"><span class="sr-only">搜索知识点</span><input type="search" placeholder="搜索知识点" data-filter-input/></label></div><div class="area-legend" aria-label="领域颜色">{[...new Set(entries.flatMap(e=>e.knowledge.map(k=>k.area).filter(Boolean)))].map(area=><span><i style={`background:${areaColors[area]||'#eeece8'}`} aria-hidden="true"></i>{area}</span>)}</div><div class="entry-content">{entries.map(e=><section class="period-section" id={`period-${e.id}`}><div class="period-heading"><h3>{period(e)}</h3></div>{e.reflection&&<div class="reflection prose">{e.reflection}</div>}{[...new Set(e.knowledge.map(k=>k.date||e.endDate))].sort((a,b)=>b.localeCompare(a)).map(date=><section class="knowledge-day"><h4>{date.slice(5).replace('-','.')}</h4><div class="knowledge-topics">{e.knowledge.filter(k=>(k.date||e.endDate)===date).map(k=><KnowledgeItem item={k} entry={e}/>)}</div></section>)}</section>)}<p id="no-results" hidden>没有找到相应内容。</p></div></Layout>
