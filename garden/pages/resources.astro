---
import Layout from '../components/AcademicLayout.astro';
import Resource from '../components/Resource.astro';
import {entries} from '../lib/data.js';
import {period} from '../lib/entry.js';
---
<Layout title="觉得不错的资料" active="resources" board><div class="page-title"><h2>觉得不错的资料</h2><label class="search"><span class="sr-only">搜索资料</span><input type="search" placeholder="搜索资料" data-filter-input/></label></div><div class="content-with-index"><div class="entry-content">{entries.map(e=><section class="period-section" id={`period-${e.id}`}><div class="period-heading"><h3>{period(e)}</h3></div>{[...e.resources].sort((a,b)=>b.date.localeCompare(a.date)).map(r=><Resource resource={r}/>)}</section>)}<p id="no-results" hidden>没有找到相应资料。</p></div></div></Layout>
