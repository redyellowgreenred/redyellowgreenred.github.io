---
import '@fontsource-variable/literata';
import '../styles/academic.css';
const {title='Knowledge',active='knowledge',board=false}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="RED的个人主页。记录日常思考与学习轨迹：Knowledge、Resources、Questions。"/><link rel="icon" href="/avatar.jpg"/><title>{title} · RED</title></head><body><div id="background-art" class="background-art" aria-hidden="true"><img src="/background.jpg" alt=""/></div><a class="skip" href="#content">跳到正文</a><div class="site"><header class="identity"><img class="portrait" src="/avatar.jpg" alt="RED的头像" width="96" height="96"/><div class="identity-text"><h1><a href="/">RED</a></h1><p>计算机系的学生</p><p class="contact">微信：<button type="button" id="copy-wechat" title="点击复制微信号">a18928774829</button><span id="copy-feedback" role="status"></span></p></div></header><nav class="main-nav" aria-label="主要板块"><a href="/" class:list={{active:active==='knowledge'}} aria-current={active==='knowledge'?'page':undefined}>Knowledge</a><a href="/resources/" class:list={{active:active==='resources'}} aria-current={active==='resources'?'page':undefined}>Resources</a><a href="/questions/" class:list={{active:active==='questions'}} aria-current={active==='questions'?'page':undefined}>Questions</a></nav><main id="content" class:list={{board}}><slot/></main><footer><a href="https://github.com/redyellowgreenred" target="_blank" rel="noopener">GitHub</a></footer></div><script>import '../scripts/academic.js';</script></body></html>
