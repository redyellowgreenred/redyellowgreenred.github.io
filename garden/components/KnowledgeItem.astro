---
const {item:k,entry:e}=Astro.props;
import {areaColors} from '../lib/areas.js';
const resources=e.resources.filter(r=>r.domainIds.includes(k.id));
const questions=e.questions.filter(q=>q.domainIds.includes(k.id));
---
<details class="knowledge-item" id={`${e.id}-${k.id}`} title={k.area||k.domain} style={`--topic-bg:${areaColors[k.area]||'#eeece8'}`} data-search={`${k.area||''} ${k.domain} ${k.concepts.join(' ')} ${k.notes||''} ${k.takeaways||''}`}><summary>{k.domain}</summary><div class="knowledge-expanded">{k.area&&<p class="area-name">{k.area}</p>}<div class="knowledge-prose">{k.concepts.map(c=><p>{c}</p>)}</div>{k.formula&&<p class="formula">{k.formula}</p>}{k.notes&&<div class="prose">{k.notes}</div>}{k.takeaways&&<div class="prose">{k.takeaways}</div>}{resources.length>0&&<div class="related-links"><span>资料</span>{resources.map(r=><a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>)}</div>}{questions.length>0&&<div class="related-links"><span>问题</span>{questions.map(q=><a href={`/questions/#${e.id}-${q.id}`}>{q.text}</a>)}</div>}</div></details>
